# /etc/default/tr-robot-head — configuración del servicio tr-robot-head
# Tras editarlo:  sudo systemctl restart tr-robot-head

# Mismo dominio que el portátil (debe coincidir en las dos máquinas)
ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=0

# Workspace de colcon donde está compilado tr_robot_head
TR_WS=__WS__

# Argumentos extra para head_launch.py, p.ej. "servos:=false alsa_device:=plughw:1,0"
TR_HEAD_ARGS=

# Solo si la red bloquea el multicast (redes de instituto): descomentar y poner
# la IP del portátil, que debe estar ejecutando el Discovery Server de Fast DDS.
#ROS_DISCOVERY_SERVER=192.168.1.50:11811
