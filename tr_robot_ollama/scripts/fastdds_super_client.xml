<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Perfil "super cliente" de Fast DDS: SOLO hace falta en modo Discovery Server,
  para que las herramientas de consola (ros2 topic list/echo, rqt...) vean
  todos los topics. Los nodos del robot no lo necesitan.

  1. Cambia 192.168.1.50 por la IP del portátil (donde corre el Discovery Server).
  2. En la terminal donde vayas a usar ros2 topic:
       export FASTRTPS_DEFAULT_PROFILES_FILE=~/ros2_ws/src/tr_robot_ollama/scripts/fastdds_super_client.xml
       ros2 daemon stop && ros2 daemon start
-->
<dds>
  <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <participant profile_name="super_client_profile" is_default_profile="true">
      <rtps>
        <builtin>
          <discovery_config>
            <discoveryProtocol>SUPER_CLIENT</discoveryProtocol>
            <discoveryServersList>
              <!-- prefix = identificador del servidor con server-id 0 -->
              <RemoteServer prefix="44.53.00.5f.45.50.52.4f.53.49.4d.41">
                <metatrafficUnicastLocatorList>
                  <locator>
                    <udpv4>
                      <address>192.168.1.50</address>
                      <port>11811</port>
                    </udpv4>
                  </locator>
                </metatrafficUnicastLocatorList>
              </RemoteServer>
            </discoveryServersList>
          </discovery_config>
        </builtin>
      </rtps>
    </participant>
  </profiles>
</dds>
