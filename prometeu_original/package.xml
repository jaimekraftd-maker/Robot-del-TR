<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tr_robot</name>
  <version>0.1.0</version>
  <description>Cabeza robótica TR: cerebro cognitivo (tr_brain) + nodos ROS 2 (cerebro, voz, visión y reconocimiento de personas) con Google Gemini.</description>
  <maintainer email="jaimekraftd@gmail.com">Jaime</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Dependencias ROS (las resuelve rosdep / ya las instala install.sh) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <!-- Dependencias Python que NO son paquetes ROS y van por pip / install.sh:
       google-generativeai, Pillow, vosk, pyaudio, pyttsx3, opencv-python. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
